# MongoDB connection string. Use a local MongoDB instance or a MongoDB Atlas URI.
MONGO_URL=mongodb://localhost:27017
DB_NAME=uniform_management

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Google OAuth settings.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional bootstrap: if no active super admin exists, these emails become super_admin on first signup.
# Leave empty so new signups stay pending until an admin assigns a role.
SUPER_ADMIN_EMAILS=